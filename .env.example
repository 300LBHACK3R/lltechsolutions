# Keep actual credentials in .env.local or the Vercel project settings.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# A sender on a domain verified in Resend. No test-sender fallback is used.
CONTACT_FROM_EMAIL=
# Optional Search Console verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Code-only purchases. Leave disabled until private archives, tax settings,
# Stripe webhook and test-mode delivery have been verified. See docs/SOURCE_DOWNLOADS_SETUP.md.
SOURCE_DOWNLOADS_ENABLED=false
SOURCE_CHECKOUT_ORIGIN=https://lltechsolutions.ca
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Explicitly choose true or false after configuring the business tax treatment in Stripe.
SOURCE_STRIPE_AUTOMATIC_TAX=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SOURCE_DOWNLOAD_SIGNING_SECRET=
SOURCE_FROM_EMAIL=
# S3-compatible private storage (AWS S3 or R2). Never make the bucket public.
SOURCE_S3_ENDPOINT=
SOURCE_S3_REGION=
SOURCE_S3_BUCKET=
SOURCE_S3_ACCESS_KEY_ID=
SOURCE_S3_SECRET_ACCESS_KEY=
